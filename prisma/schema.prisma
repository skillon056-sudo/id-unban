// Prisma schema. Uses PostgreSQL (required for Vercel / any serverless host).
// Set DATABASE_URL in .env to your Postgres connection string (e.g. Neon).
// For zero-config local dev you may instead set provider = "sqlite" and
// DATABASE_URL = "file:./dev.db", but the committed value must be postgresql
// for the Vercel build. Statuses are stored as strings and validated in the
// app layer (src/lib/validation.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FreeFireId {
  id           String   @id @default(cuid())
  gameId       String   @unique
  status       String   @default("BANNED") // BANNED | UNBANNED | PENDING
  banReason    String?
  banDuration  String?  // e.g. "Permanent", "30 days" — shown on the result card
  unbanEnabled Boolean  @default(true)
  freeUnban    Boolean  @default(false) // when true, unban skips payment (OTP -> direct success)
  otp          String?  // if set, the exact OTP the user must enter; empty = accept any OTP
  price        Int?     // per-ID unban price; falls back to global unban_price when null
  unbanLeft    Int?     // shown on the site as "Unban Left: N times"
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

model UnbanRequest {
  id       String @id @default(cuid())
  gameId   String
  orderId  String @unique
  amount   Int
  currency String @default("INR")

  // What the customer told us, so we can actually file the appeal for them.
  contactEmail String?
  contactPhone String?
  details      String?

  // Case workflow: NEW -> IN_PROGRESS -> FILED -> CLOSED (or REJECTED).
  status     String  @default("PENDING")
  adminNotes String?
  // Set once the Purchase conversion has been reported, so refreshes,
  // extra tabs and webhook retries can never double-count it.
  purchaseReported Boolean @default(false)
  // Ad-click identifiers captured while the browser was still here (_fbc/_fbp,
  // ip, user agent), replayed in the server-side conversion. Without them the
  // gateway's dead end would cost us the link back to the ad that paid for it.
  attribution      String?
  // First time the customer opened the deposit step — the step's own countdown
  // runs from here, so it can't be restarted by reloading.
  depositSeenAt    DateTime?
  filedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gameId])
  @@index([status])
}

model Payment {
  id              String   @id @default(cuid())
  orderId         String   @unique
  // SERVICE = the appeal fee. DEPOSIT = the follow-up security deposit.
  kind            String   @default("SERVICE")
  // For a DEPOSIT, the service order it belongs to.
  parentOrderId   String?
  gameId          String
  transactionId   String?
  amount          Int
  currency        String   @default("INR")
  status          String   @default("CREATED") // CREATED | PENDING | SUCCESS | FAILED | CANCELLED
  gatewayResponse String?  // raw JSON string from gateway (audit trail)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([transactionId])
  @@index([gameId])
  @@index([parentOrderId])
}

model Refund {
  id        String @id @default(cuid())
  // The deposit payment being refunded.
  orderId   String @unique
  requestId String
  gameId    String

  amount   Int
  currency String @default("INR")
  // Older refunds were collected as a UPI handle; newer ones as a phone number.
  upiId    String
  phone    String?

  // NOT_REQUESTED -> PENDING -> PROCESSING -> COMPLETED | FAILED
  status    String  @default("NOT_REQUESTED")
  reference String? // payout/UTR reference once actually sent
  notes     String?

  // Set when the payout is sent through the gateway rather than by hand.
  payoutId      String?  @unique // our id, also the gateway's idempotency key
  payoutStatus  String?  // gateway's own status: pending/processing/success/failed
  payoutMethod  String?  // upi | bank
  payoutAccount String?  // VPA or account number the money was sent to
  payoutSentAt  DateTime?

  requestedAt DateTime?
  refundedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([requestId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// A payout sent from the admin panel: operator types the destination and the
// amount, so it isn't tied to any order. payoutId is what the gateway gets as
// its idempotency key, and is what its callbacks come back with.
model Payout {
  id       String @id @default(cuid())
  payoutId String @unique

  amount   Int
  currency String @default("INR")

  method             String  // upi | bank
  beneficiaryName    String
  beneficiaryAccount String
  ifsc               String?
  bankName           String?
  note               String?

  // PENDING -> SENT -> COMPLETED | FAILED
  status        String  @default("PENDING")
  gatewayStatus String?
  utr           String?
  error         String?

  // Charged by the gateway on top of the amount; debit is what actually left
  // the balance. Both arrive on the payout callbacks.
  fee   Int?
  debit Int?
  // "admin" = sent from this panel, "dashboard" = sent from the gateway's own
  // panel and learned about from its callback.
  source String @default("admin")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  settledAt DateTime?

  @@index([status])
  @@index([createdAt])
}
