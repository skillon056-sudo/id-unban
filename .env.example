# ─────────────────────────────────────────────────────────────
# Database
# Dev default is SQLite (zero-config). To use PostgreSQL:
#   1. set provider = "postgresql" in prisma/schema.prisma
#   2. set DATABASE_URL to your Postgres connection string
# ─────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ─────────────────────────────────────────────────────────────
# Admin bootstrap account (used by `npm run db:seed`)
# ─────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe_123!"

# Session signing secret — MUST be a long random string in production.
# Generate one: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
SESSION_SECRET="dev-secret-change-me-to-a-long-random-string"

# ─────────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME="Rebooter — FF ID Recovery"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Reference website for visual inspiration only (not used at runtime).
NEXT_PUBLIC_REFERENCE_URL="https://ff.garena.com/en"

# ─────────────────────────────────────────────────────────────
# Payment
# PAYMENT_GATEWAY selects the active gateway implementation:
#   "mock"   -> local simulated checkout (default, works out of the box)
#   "sunpay" -> real Sunpay gateway (fill credentials below)
# ─────────────────────────────────────────────────────────────
PAYMENT_GATEWAY="mock"
UNBAN_PRICE="199"
PAYMENT_CURRENCY="INR"

# ─────────────────────────────────────────────────────────────
# Sunpay pay-in (deposits / money IN). Secrets: env only.
# See src/services/payment/sunpay.ts.
# ─────────────────────────────────────────────────────────────
SUNPAY_BASE_URL="https://sunpaytm.quest"
SUNPAY_ENABLED="true"
SUNPAY_CURRENCY="INR"
SUNPAY_METHOD="upi"
SUNPAY_PAYIN_PATH="/api/public/v1/payins"
SUNPAY_MIN_AMOUNT="100"
SUNPAY_PAYIN_API_KEY=
SUNPAY_PAYIN_API_SECRET=
SUNPAY_WEBHOOK_SECRET=
